@model DomeneOS.ViewModels.RegisterViewModel

@{
    Layout = "LayoutLogin";
    ViewData["Title"] = "Criar Conta";
}

<div class="login-container register-container">
    <section class="login-left">
        <img src="~/images/logo Domenetech.png
             alt="DomeneTech"
             class="login-logo" />

        <h1>DomeneOS</h1>

        <p>
            Sistema de gestão para<br />
            assistência técnica
        </p>
    </section>

    <section class="login-right">
        <div class="login-form register-form">
            <h2>Criar conta</h2>

            <span>
                Preencha seus dados para acessar o sistema.
            </span>

            <form asp-action="Registrar" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label">
                        Nome
                    </label>

                    <input asp-for="Nome"
                           class="form-control"
                           placeholder="Digite seu nome"
                           autocomplete="name" />

                    <span asp-validation-for="Nome"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">
                        E-mail
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="seu@email.com"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Senha" class="form-label">
                        Senha
                    </label>

                    <input asp-for="Senha"
                           class="form-control"
                           placeholder="Digite sua senha"
                           autocomplete="new-password" />

                    <span asp-validation-for="Senha"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmarSenha" class="form-label">
                        Confirmar senha
                    </label>

                    <input asp-for="ConfirmarSenha"
                           class="form-control"
                           placeholder="Digite a senha novamente"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmarSenha"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit" class="btn btn-login">
                    <i class="bi bi-person-plus"></i>
                    Criar conta
                </button>

                <div class="login-register">
                    <span>Já possui uma conta?</span>
                    <a asp-action="Login">Entrar</a>
                </div>
            </form>

            <div class="login-footer">
                © 2026 DomeneTech. Todos os direitos reservados.
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}