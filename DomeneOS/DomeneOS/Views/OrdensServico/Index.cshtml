@model IEnumerable<DomeneOS.Models.OrdemServico>

@{
    ViewData["Title"] = "Ordens de Serviço";
    var pesquisa = ViewBag.Pesquisa as string;
    var statusSelecionado = ViewBag.StatusSelecionado as string;
}

<div class="container-fluid py-4">

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Erro"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Sucesso"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Ordens de Serviço</h1>

            <p class="text-muted mb-0">
                Gerencie e acompanhe as ordens de serviço.
            </p>
        </div>

        <a asp-action="Criar" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Nova Ordem de Serviço
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end mb-3">

                <div class="col-md-10">
                    <label for="pesquisa" class="form-label">
                        Pesquisar
                    </label>

                    <input type="text"
                           id="pesquisa"
                           name="pesquisa"
                           value="@pesquisa"
                           class="form-control"
                           placeholder="Pesquise pelo cliente, descrição ou número da ordem" />

                    @if (!string.IsNullOrWhiteSpace(statusSelecionado))
                    {
                        <input type="hidden"
                               name="status"
                               value="@statusSelecionado" />
                    }
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-outline-primary">
                        Buscar
                    </button>
                </div>
            </form>

            <div class="d-flex flex-wrap gap-2">

                <a asp-action="Index"
                   asp-route-pesquisa="@pesquisa"
                   class="btn btn-outline-secondary btn-sm">
                    Todas
                </a>

                <a asp-action="Index"
                   asp-route-status="Aberta"
                   asp-route-pesquisa="@pesquisa"
                   class="btn btn-outline-primary btn-sm">
                    Aberta
                </a>

                <a asp-action="Index"
                   asp-route-status="EmAndamento"
                   asp-route-pesquisa="@pesquisa"
                   class="btn btn-outline-warning btn-sm">
                    Em andamento
                </a>

                <a asp-action="Index"
                   asp-route-status="Finalizada"
                   asp-route-pesquisa="@pesquisa"
                   class="btn btn-outline-success btn-sm">
                    Finalizada
                </a>

                <a asp-action="Index"
                   asp-route-status="Cancelada"
                   asp-route-pesquisa="@pesquisa"
                   class="btn btn-outline-danger btn-sm">
                    Cancelada
                </a>

                @if (!string.IsNullOrWhiteSpace(pesquisa) ||
                !string.IsNullOrWhiteSpace(statusSelecionado))
                {
                    <a asp-action="Index"
                       class="btn btn-link btn-sm text-decoration-none">
                        Limpar filtros
                    </a>
                }

            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h5>Nenhuma ordem de serviço encontrada</h5>

                    <p class="text-muted mb-3">
                        Crie uma nova ordem ou altere os filtros da pesquisa.
                    </p>

                    <a asp-action="Criar" class="btn btn-primary">
                        Nova Ordem de Serviço
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Cliente</th>
                                <th>Descrição</th>
                                <th>Status</th>
                                <th>Valor</th>
                                <th>Data de Abertura</th>
                                <th>Finalização</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var ordem in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @ordem.Cliente.Nome
                                    </td>

                                    <td>
                                        @ordem.DescricaoProblema
                                    </td>

                                    <td>
                                        @switch (ordem.Status)
                                        {
                                            case StatusOrdemServico.Aberta:
                                                <span class="badge bg-primary">
                                                    Aberta
                                                </span>
                                                break;

                                            case StatusOrdemServico.EmAndamento:
                                                <span class="badge bg-warning text-dark">
                                                    Em andamento
                                                </span>
                                                break;

                                            case StatusOrdemServico.Finalizada:
                                                <span class="badge bg-success">
                                                    Finalizada
                                                </span>
                                                break;

                                            case StatusOrdemServico.Cancelada:
                                                <span class="badge bg-danger">
                                                    Cancelada
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        @ordem.Valor.ToString("C")
                                    </td>

                                    <td>
                                        @ordem.DataAbertura.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @(ordem.DataFinalizacao.HasValue
                                            ? ordem.DataFinalizacao.Value.ToString("dd/MM/yyyy")
                                            : "-")
                                    </td>

                                    <td class="text-end">
                                        <a asp-action="Detalhes"
                                           asp-route-id="@ordem.Id"
                                           class="btn btn-info btn-sm">
                                            <i class="bi bi-eye"></i>
                                            Detalhes
                                        </a>

                                        <a asp-action="Editar"
                                           asp-route-id="@ordem.Id"
                                           class="btn btn-warning btn-sm">
                                            <i class="bi bi-pencil-square"></i>
                                            Editar
                                        </a>

                                        <form asp-action="Excluir"
                                              asp-route-id="@ordem.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Tem certeza que deseja excluir esta ordem de serviço?');">
                                                <i class="bi bi-trash"></i>
                                                Excluir
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
</div>