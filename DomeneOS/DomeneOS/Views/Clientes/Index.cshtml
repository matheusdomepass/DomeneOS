@model IEnumerable<DomeneOS.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container-fluid py-4">

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Erro"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Sucesso"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Clientes</h1>

            <p class="text-muted mb-0">
                Gerencie os clientes cadastrados.
            </p>
        </div>

        <a asp-action="Criar" class="btn btn-domene-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Novo Cliente
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-10">
                    <label for="pesquisa" class="form-label">
                        Pesquisar
                    </label>

                    <input type="text"
                           id="pesquisa"
                           name="pesquisa"
                           value="@ViewBag.Pesquisa"
                           class="form-control"
                           placeholder="Pesquise pelo nome, CPF ou CNPJ" />
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-outline-primary">
                        Buscar
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(ViewBag.Pesquisa as string))
                {
                    <div class="col-12">
                        <a asp-action="Index" class="text-decoration-none">
                            Limpar pesquisa
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h5>Nenhum cliente encontrado</h5>

                    <p class="text-muted mb-3">
                        Cadastre um novo cliente ou altere a pesquisa.
                    </p>

                    <a asp-action="Criar" class="btn btn-domene-primary">
                        Novo Cliente
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Nome</th>
                                <th>Telefone</th>
                                <th>Email</th>
                                <th>CPF/CNPJ</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var cliente in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @cliente.Nome
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(cliente.Telefone)
                                            ? "-"
                                            : cliente.Telefone)
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(cliente.Email)
                                            ? "-"
                                            : cliente.Email)
                                    </td>

                                    <td>
                                        @cliente.CpfCnpj
                                    </td>

                                    <td class="text-end">
                                        <a asp-action="Detalhes"
                                           asp-route-id="@cliente.Id"
                                           class="btn btn-info btn-sm btn-action">
                                            <i class="bi bi-eye"></i>
                                            Detalhes
                                        </a>

                                        <a asp-action="Editar"
                                           asp-route-id="@cliente.Id"
                                           class="btn btn-warning btn-sm btn-action">
                                            <i class="bi bi-pencil-square"></i>
                                            Editar
                                        </a>

                                        <form asp-action="Excluir"
                                              asp-route-id="@cliente.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm btn-action"
                                                    onclick="return confirm('Tem certeza que deseja excluir esse cliente?');">
                                                <i class="bi bi-trash"></i>
                                                Excluir
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
</div>