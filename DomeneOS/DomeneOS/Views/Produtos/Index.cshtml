@model IEnumerable<DomeneOS.Models.Produto>

@{
    ViewData["Title"] = "Produtos";
    var busca = ViewBag.Busca as string;
    var mostrarInativos = ViewBag.MostrarInativos is true;
}

<div class="container-fluid py-4">
    
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Sucesso"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Produtos</h1>

            <p class="text-muted mb-0">
                Gerencie os produtos e acompanhe o estoque.
            </p>
        </div>

        <a asp-action="Criar" class="btn btn-domene-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Novo produto
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-7">
                    <label for="busca" class="form-label">
                        Pesquisar
                    </label>

                    <input type="text"
                           id="busca"
                           name="busca"
                           value="@busca"
                           class="form-control"
                           placeholder="Pesquise por nome, código ou fornecedor" />
                </div>

                <div class="col-md-3">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input"
                               type="checkbox"
                               id="mostrarInativos"
                               name="mostrarInativos"
                               value="true"
                        @(mostrarInativos ? "checked" : null) />

                        <label class="form-check-label"
                               for="mostrarInativos">
                            Mostrar inativos
                        </label>
                    </div>
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-outline-primary">
                        Pesquisar
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(busca) || mostrarInativos)
                {
                    <div class="col-12">
                        <a asp-action="Index"
                           class="text-decoration-none">
                            Limpar filtros
                        </a>
                    </div>
                }

            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h5>Nenhum produto encontrado</h5>

                    <p class="text-muted mb-3">
                        Cadastre um produto ou altere os filtros da pesquisa.
                    </p>

                    <a asp-action="Criar" class="btn btn-primary">
                        Novo produto
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Produto</th>
                                <th>Fornecedor</th>
                                <th>Estoque</th>
                                <th>Preço de venda</th>
                                <th>Status</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var produto in Model)
                            {
                                <tr class="@(!produto.Ativo ? "table-secondary" : "")">

                                    <td>
                                        @produto.Codigo
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @produto.Nome
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(produto.Descricao))
                                        {
                                            <small class="text-muted">
                                                @(produto.Descricao.Length > 60
                                                    ? produto.Descricao[..60] + "..."
                                                    : produto.Descricao)
                                            </small>
                                        }
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(produto.Fornecedor)
                                            ? "-"
                                            : produto.Fornecedor)
                                    </td>

                                    <td>
                                        @if (produto.EstoqueBaixo)
                                        {
                                            <span class="badge bg-danger">
                                                @produto.QuantidadeEstoque
                                            </span>

                                            <small class="d-block text-danger mt-1">
                                                Mínimo: @produto.EstoqueMinimo
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                @produto.QuantidadeEstoque
                                            </span>

                                            <small class="d-block text-muted mt-1">
                                                Mínimo: @produto.EstoqueMinimo
                                            </small>
                                        }
                                    </td>

                                    <td>
                                        @produto.PrecoVenda.ToString("C")
                                    </td>

                                    <td>
                                        @if (produto.Ativo)
                                        {
                                            <span class="badge bg-success">
                                                Ativo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inativo
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="d-inline-flex flex-wrap justify-content-end gap-2">

                                            <a asp-action="Detalhes"
                                               asp-route-id="@produto.Id"
                                               class="btn btn-info btn-sm btn-action">
                                                <i class="bi bi-eye"></i>
                                                Detalhes
                                            </a>

                                            <a asp-action="Editar"
                                               asp-route-id="@produto.Id"
                                               class="btn btn-warning btn-sm btn-action">
                                                <i class="bi bi-pencil-square"></i>
                                                Editar
                                            </a>

                                            <form asp-action="AlterarStatus"
                                                  asp-route-id="@produto.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                @if (produto.Ativo)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm btn-action"
                                                            onclick="return confirm('Deseja desativar este produto?');">
                                                        <i class="bi bi-x-circle"></i>
                                                        Desativar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-success btn-sm btn-action"
                                                            onclick="return confirm('Deseja ativar este produto?');">
                                                        <i class="bi bi-check-circle"></i>
                                                        Ativar
                                                    </button>
                                                }

                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
</div>